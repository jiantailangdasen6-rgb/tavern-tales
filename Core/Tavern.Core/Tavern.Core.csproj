<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity-independent game core. Unity references this folder as a local package (file:../../Core/Tavern.Core). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Tavern.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="bin~/**;obj~/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Unity gets the same library from com.unity.nuget.newtonsoft-json -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
